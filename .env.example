# ------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha com os dados do seu
# ambiente de teste. O ".env" está no .gitignore e NUNCA deve ser
# commitado.
#
#   cp .env.example .env
# ------------------------------------------------------------------

# Ambiente padrão quando ENV não for informado no comando (dev | prod)
ENV=dev

# URL base da aplicação em cada ambiente
BASE_URL_DEV=https://dev.sua-aplicacao.com
BASE_URL_PROD=https://sua-aplicacao.com

# Usuário de teste do ambiente de desenvolvimento
DEV_USER=usuario.teste@exemplo.com
DEV_PASSWORD=sua_senha_dev

# Usuário de teste do ambiente de produção
PROD_USER=usuario.teste@exemplo.com
PROD_PASSWORD=sua_senha_prod
